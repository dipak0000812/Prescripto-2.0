# ==============================================================================
# Prescripto AI 2.0 — Environment Configuration Template
# All settings match docs/DEPLOYMENT.md and prescripto/config/settings.py
# ==============================================================================

# Runtime Environment (development | staging | production)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database — copy this file to backend/.env for host processes (API/worker on the host).
# Compose publishes Postgres at localhost:5435. Inside Docker, compose overrides
# DATABASE_URL to postgresql+psycopg2://prescripto:prescripto_secret@postgres:5432/prescripto_db
DATABASE_URL=postgresql+psycopg2://prescripto:prescripto_secret@localhost:5435/prescripto_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# CORS Configuration (Vite :5173, optional CRA :3000)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Object Storage Configuration (MinIO for dev, S3 for prod)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=prescripto
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# Separately permissioned vault for DPDPA deletion manifests & audit exports
RETENTION_VAULT_BUCKET=prescripto-retention

# JWT RS256 Authentication (PEM format strings or paths)
# Generate with: python scripts/generate_keys.py
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""
JWT_ACCESS_TTL=900        # 15 minutes
JWT_REFRESH_TTL=604800    # 7 days

# Machine Learning & Vision Recognition Configuration
OCR_MODEL_NAME=pp-ocrv6              # PP-OCRv6 (PaddleOCR) — active runtime in ml/app/
OCR_MODEL_VERSION=1.0.0              # Exact version — never "latest"
MODEL_CACHE_DIR=/tmp/prescripto_models
ML_RUNTIME_MODE=rapidocr             # Keep rapidocr for Gemini fallback. Do not set remote (ml-service disabled).
ML_SERVICE_URL=http://localhost:8001 # Unused unless ML_RUNTIME_MODE=remote (disabled)

# Recognition Provider & Google Gemini Vision
RECOGNITION_PROVIDER=gemini          # Default. RapidOCR is used only if Gemini hits quota/auth/timeout.
GEMINI_API_KEY=""                    # Required for Gemini. Enter locally or in the backend secret manager.
GEMINI_MODEL=gemini-3.5-flash        # Primary Gemini model name for vision recognition.
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite # Fallback Gemini model name before RapidOCR.

# Feature & Safety Flags
LLM_ENABLED=false                    # Optional commentary layer; recognition runs via RECOGNITION_PROVIDER
ENABLED_KNOWLEDGE_PROVIDERS=openfda,cdsco
LICENSE_MODE_ALLOWED=COMMERCIAL_PERMISSIVE  # Options: COMMERCIAL_PERMISSIVE, RESEARCH_ONLY, PUBLIC_DOMAIN
OPENFDA_API_KEY=""

# Ingestion & Retention Limits
RETENTION_DAYS=30
MAX_UPLOAD_BYTES=20971520 # 20 MB
