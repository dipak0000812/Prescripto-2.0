# ==============================================================================
# Prescripto AI 2.0 — Environment Configuration Template
# All settings match docs/DEPLOYMENT.md and prescripto/config/settings.py
# ==============================================================================

# Runtime Environment (development | staging | production)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Configuration (PostgreSQL 16+)
DATABASE_URL=postgresql+psycopg2://prescripto:prescripto_secret@localhost:5432/prescripto_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Object Storage Configuration (MinIO for dev, S3 for prod)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=prescripto
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# Separately permissioned vault for DPDPA deletion manifests & audit exports
RETENTION_VAULT_BUCKET=prescripto-retention

# JWT RS256 Authentication (PEM format strings or paths)
# Generate with: python scripts/generate_keys.py
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""
JWT_ACCESS_TTL=900        # 15 minutes
JWT_REFRESH_TTL=604800    # 7 days

# Machine Learning & OCR Configuration
OCR_MODEL_NAME=pp-ocrv6              # PP-OCRv6 (PaddleOCR) — active runtime in ml/app/
OCR_MODEL_VERSION=1.0.0              # Exact version — never "latest"
MODEL_CACHE_DIR=/tmp/prescripto_models
ML_RUNTIME_MODE=mock                 # Options: mock | remote (remote calls ml-service on ML_SERVICE_URL)
ML_SERVICE_URL=http://localhost:8001

# Feature & Safety Flags
LLM_ENABLED=false
ENABLED_KNOWLEDGE_PROVIDERS=openfda,cdsco
LICENSE_MODE_ALLOWED=COMMERCIAL_PERMISSIVE  # Options: COMMERCIAL_PERMISSIVE, RESEARCH_ONLY, PUBLIC_DOMAIN
OPENFDA_API_KEY=""

# Ingestion & Retention Limits
RETENTION_DAYS=30
MAX_UPLOAD_BYTES=20971520 # 20 MB
