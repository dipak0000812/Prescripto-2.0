# ==============================================================================
# Prescripto AI 2.0 — Production Environment Configuration
# Copy this file to backend/.env.prod and fill in all required secrets
# ==============================================================================

# Runtime Environment
ENVIRONMENT=production
LOG_LEVEL=INFO

# Database — Use Render PostgreSQL connection string
# Format: postgresql+psycopg2://user:password@host:5432/dbname
DATABASE_URL=postgresql+psycopg2://prescripto:${POSTGRES_PASSWORD}@postgres:5432/prescripto_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30

# CORS Configuration — Production frontend URL
CORS_ORIGINS=https://prescripto-2-0.onrender.com,https://prescripto.ai,https://www.prescripto.ai

# Object Storage Configuration (S3 / MinIO)
S3_ENDPOINT=https://s3.amazonaws.com
S3_BUCKET=prescripto-prod
S3_ACCESS_KEY=${S3_ACCESS_KEY}
S3_SECRET_KEY=${S3_SECRET_KEY}
S3_REGION=us-east-1

# Separately permissioned vault for DPDPA deletion manifests & audit exports
RETENTION_VAULT_BUCKET=prescripto-retention-prod

# JWT RS256 Authentication (PEM format strings)
# Generate with: python scripts/generate_keys.py
JWT_PRIVATE_KEY=${JWT_PRIVATE_KEY}
JWT_PUBLIC_KEY=${JWT_PUBLIC_KEY}
JWT_ACCESS_TTL=900        # 15 minutes
JWT_REFRESH_TTL=604800    # 7 days

# Machine Learning & Vision Recognition Configuration
OCR_MODEL_NAME=pp-ocrv6
OCR_MODEL_VERSION=1.0.0
MODEL_CACHE_DIR=/tmp/prescripto_models
ML_RUNTIME_MODE=rapidocr
ML_SERVICE_URL=http://localhost:8001

# Recognition Provider & Google Gemini Vision
RECOGNITION_PROVIDER=gemini
GEMINI_API_KEY=${GEMINI_API_KEY}
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Feature & Safety Flags
LLM_ENABLED=false
ENABLED_KNOWLEDGE_PROVIDERS=openfda,cdsco
LICENSE_MODE_ALLOWED=COMMERCIAL_PERMISSIVE
OPENFDA_API_KEY=${OPENFDA_API_KEY}

# Ingestion & Retention Limits
RETENTION_DAYS=90
MAX_UPLOAD_BYTES=20971520 # 20 MB

# Worker Engine Configuration
WORKER_ID=prod-worker-1
WORKER_POLL_INTERVAL=2.0
WORKER_LEASE_SECONDS=600
WORKER_HEARTBEAT_SECONDS=30
WORKER_MAX_RETRIES=3

# Medicine Reminder & Web Push (VAPID) Configuration
# Generate with: python scripts/generate_vapid_keys.py
VAPID_PUBLIC_KEY=${VAPID_PUBLIC_KEY}
VAPID_PRIVATE_KEY=${VAPID_PRIVATE_KEY}
VAPID_CLAIMS_SUB=mailto:support@prescripto.ai